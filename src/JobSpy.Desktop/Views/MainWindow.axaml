<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:JobSpy.Desktop.ViewModels"
        xmlns:controls="using:JobSpy.Desktop.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="820"
        x:Class="JobSpy.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="JobSpy | Role Market"
        Width="1180" Height="820" MinWidth="900" MinHeight="680"
        Background="#F3F5F2">

    <Window.Styles>
        <Style Selector="ToggleButton.timeline-point">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style Selector="ToggleButton.timeline-point:checked">
            <Setter Property="Background" Value="#EAF2EC" />
        </Style>
        <Style Selector="StackPanel.legend-item">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="StackPanel.legend-item > Border">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="StackPanel.legend-item > TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.scan-button">
            <Setter Property="Background" Value="#F1B45A" />
            <Setter Property="Foreground" Value="#25352C" />
            <Setter Property="BorderBrush" Value="#D99A41" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.scan-button:pointerover">
            <Setter Property="Background" Value="#FFC86C" />
            <Setter Property="BorderBrush" Value="#E7AA4E" />
        </Style>
        <Style Selector="Button.scan-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FFC86C" />
            <Setter Property="BorderBrush" Value="#E7AA4E" />
            <Setter Property="Foreground" Value="#25352C" />
        </Style>
        <Style Selector="Button.scan-button:pressed">
            <Setter Property="Background" Value="#D99534" />
            <Setter Property="BorderBrush" Value="#BB7623" />
            <Setter Property="Foreground" Value="#1F3028" />
        </Style>
        <Style Selector="Button.scan-button:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#D99534" />
            <Setter Property="BorderBrush" Value="#BB7623" />
            <Setter Property="Foreground" Value="#1F3028" />
        </Style>
        <Style Selector="Button.scan-button:disabled">
            <Setter Property="Background" Value="#D8DDD9" />
            <Setter Property="BorderBrush" Value="#D8DDD9" />
            <Setter Property="Foreground" Value="#79847E" />
        </Style>
        <Style Selector="Button.scan-button:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#D8DDD9" />
            <Setter Property="BorderBrush" Value="#D8DDD9" />
            <Setter Property="Foreground" Value="#79847E" />
        </Style>
        <Style Selector="Button.open-posting-button">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#174B3D" />
            <Setter Property="BorderBrush" Value="#B7CBBE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.open-posting-button:pointerover">
            <Setter Property="Background" Value="#EAF3EC" />
            <Setter Property="BorderBrush" Value="#87AC93" />
        </Style>
        <Style Selector="Button.open-posting-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#EAF3EC" />
            <Setter Property="BorderBrush" Value="#87AC93" />
            <Setter Property="Foreground" Value="#174B3D" />
        </Style>
        <Style Selector="Button.open-posting-button:pressed">
            <Setter Property="Background" Value="#D4E5D8" />
            <Setter Property="BorderBrush" Value="#6F9B7D" />
        </Style>
        <Style Selector="Button.open-posting-button:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#D4E5D8" />
            <Setter Property="BorderBrush" Value="#6F9B7D" />
            <Setter Property="Foreground" Value="#174B3D" />
        </Style>
        <Style Selector="Button.open-posting-button:disabled">
            <Setter Property="Background" Value="#F2F4F2" />
            <Setter Property="BorderBrush" Value="#E1E6E1" />
            <Setter Property="Foreground" Value="#89948D" />
        </Style>
        <Style Selector="Button.open-posting-button:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#F2F4F2" />
            <Setter Property="BorderBrush" Value="#E1E6E1" />
            <Setter Property="Foreground" Value="#89948D" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,*">
        <Border Background="#174B3D" Padding="26,18">
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                <StackPanel Spacing="3">
                    <TextBlock Text="JOBSPY  /  ROLE MARKET" FontSize="11" FontWeight="Bold" Foreground="#A7D8BD" />
                    <TextBlock Text="Senior .NET opportunities" FontSize="25" FontWeight="SemiBold" Foreground="White" />
                </StackPanel>
                <Button Grid.Column="1" Content="Scan profile" Classes="scan-button"
                    Command="{Binding SearchCommand}" Padding="18,10"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="White" BorderBrush="#DEE5DF" BorderThickness="0,0,0,1" Padding="26,14">
            <StackPanel Spacing="3">
                <TextBlock Text="TARGET PROFILE" FontSize="10" FontWeight="Bold" Foreground="#68786F" />
                <TextBlock Text="{Binding SearchTermsLabel}" FontSize="13" FontWeight="SemiBold"
                           Foreground="#263B31" TextWrapping="Wrap" />
                <TextBlock Text="{Binding SearchLocationLabel}" FontSize="11" Foreground="#68786F" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="24,16" RowDefinitions="Auto,Auto,*" RowSpacing="8">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="16" VerticalAlignment="Center">
                <StackPanel Spacing="2">
                    <TextBlock Text="MATCHING ROLES" FontSize="10" FontWeight="Bold" Foreground="#718078" />
                    <TextBlock Text="{Binding ResultCount}" FontSize="22" FontWeight="SemiBold" Foreground="#20382E" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="MEDIAN REPORTED SALARY" FontSize="10" FontWeight="Bold" Foreground="#718078" />
                    <TextBlock Text="{Binding MedianSalaryLabel}" FontSize="22" FontWeight="SemiBold" Foreground="#B9683D" />
                    <TextBlock Text="{Binding SalaryCoverageLabel}" FontSize="10" Foreground="#718078" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="2">
                    <TextBlock Text="SELECTED SCAN" FontSize="10" FontWeight="Bold" Foreground="#718078" />
                    <TextBlock Text="{Binding CapturedAtLabel}" FontSize="13" FontWeight="SemiBold" Foreground="#20382E" />
                </StackPanel>
                <StackPanel Grid.Column="4" Spacing="2" VerticalAlignment="Bottom">
                    <TextBlock Text="{Binding SnapshotKindLabel}" FontSize="10"
                               FontWeight="Bold" Foreground="#A66A28" />
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,3,0,0">
                        <ComboBox Width="140" ItemsSource="{Binding LocationFilters}"
                        SelectedItem="{Binding SelectedLocationFilter}" MinHeight="0"
                        HorizontalContentAlignment="Stretch" ToolTip.Tip="Filter by location">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:LocationFilterOption">
                                <TextBlock Text="{Binding Label}" FontSize="11" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox Width="140" ItemsSource="{Binding SourceFilters}"
                        SelectedItem="{Binding SelectedSourceFilter}" MinHeight="0"
                        HorizontalContentAlignment="Stretch" ToolTip.Tip="Filter by source">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:LocationFilterOption">
                                <TextBlock Text="{Binding Label}" FontSize="11" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox Width="118" ItemsSource="{Binding StatusFilters}"
                                  SelectedItem="{Binding SelectedStatusFilter}" MinHeight="0"
                                  HorizontalContentAlignment="Stretch" ToolTip.Tip="Filter by status">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:LocationFilterOption">
                                    <TextBlock Text="{Binding Label}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <CheckBox Content="New openings today" Height="10"  Margin="0,-3,0,0"
                                  IsChecked="{Binding IsNewTodayFilterEnabled}" VerticalAlignment="Center"
                                  FontSize="11" ToolTip.Tip="Show jobs posted today" />
                        <CheckBox Content="C# / .NET only" Height="10" Margin="0,-3,0,0"
                                  IsChecked="{Binding IsDotNetLanguageFilterEnabled}" VerticalAlignment="Center"
                                  FontSize="11" ToolTip.Tip="Keep roles mentioning C# or .NET; exclude roles focused on other programming languages" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="White" BorderBrush="#DEE5DF" BorderThickness="1" Padding="16,13">
                <Grid RowDefinitions="Auto,*" RowSpacing="8">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto"
                          RowSpacing="5" VerticalAlignment="Center">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Scan history" FontSize="16" FontWeight="SemiBold" Foreground="#20382E" />
                            <TextBlock Text="Select a point to inspect the roles seen in that scan." FontSize="11" Foreground="#718078" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <StackPanel Classes="legend-item" Orientation="Horizontal" Spacing="4"><Border Width="18" Height="16" Background="#168264" /><TextBlock Text="Permanent" FontSize="10" Foreground="#52615A" /></StackPanel>
                            <StackPanel Classes="legend-item" Orientation="Horizontal" Spacing="4"><Border Width="18" Height="16" Background="#C36A3D" /><TextBlock Text="Contract" FontSize="10" Foreground="#52615A" /></StackPanel>
                            <StackPanel Classes="legend-item" Orientation="Horizontal" Spacing="4"><Border Width="18" Height="16" Background="#397AA6" /><TextBlock Text="Part-time" FontSize="10" Foreground="#52615A" /></StackPanel>
                            <StackPanel Classes="legend-item" Orientation="Horizontal" Spacing="4"><Border Width="18" Height="16" Background="#78847D" /><TextBlock Text="Other / unknown" FontSize="10" Foreground="#52615A" /></StackPanel>
                            <StackPanel Classes="legend-item" Orientation="Horizontal" Spacing="4"><Border Width="18" Height="16" Background="#168264" Opacity="0.45" /><TextBlock Text="Needs relocation (faded)" FontSize="10" Foreground="#52615A" /></StackPanel>
                            <StackPanel Classes="legend-item" Orientation="Horizontal" Spacing="4"><Border Width="18" Height="16" Background="#168264" ClipToBounds="True"><Border Background="#1A7030A0" /></Border><TextBlock Text="Management" FontSize="10" Foreground="#52615A" /></StackPanel>
                            <StackPanel Classes="legend-item" Orientation="Horizontal" Spacing="4"><Border Width="18" Height="16" Background="#E4EAE5" ClipToBounds="True"><TextBlock Text="////" Foreground="#283A32" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="Salary estimated (striped)" FontSize="10" Foreground="#52615A" /></StackPanel>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding StatusMessage}"
                                   FontSize="10" Foreground="#68786F" TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding StatusMessage}" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <controls:SalaryHistoryChart ItemsSource="{Binding ChartPoints}"
                                                     SelectedPoint="{Binding SelectedPoint}"
                                                     SelectionCommand="{Binding SelectSnapshotCommand}"
                                                     RunSelectionCommand="{Binding SelectRunCommand}"
                                                     Height="230" />
                    </ScrollViewer>
                    <TextBlock Grid.Row="1" Text="No scan history yet" IsVisible="{Binding HasNoHistory}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"
                               FontWeight="SemiBold" Foreground="#718078" />
                </Grid>
            </Border>

            <Grid Grid.Row="2" ColumnDefinitions="1.05*,1.4*" ColumnSpacing="12">
                <Border Background="White" BorderBrush="#DEE5DF" BorderThickness="1">
                    <Grid RowDefinitions="Auto,*">
                        <Border Padding="8,7" BorderBrush="#E4E9E5" BorderThickness="0,0,0,1" Background="#F8FAF8">
                            <Grid ColumnSpacing="8" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="84" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="ROLE" FontSize="10" FontWeight="Bold" Foreground="#718078" />
                                <TextBlock Grid.Column="1" Text="COMPANY" FontSize="10" FontWeight="Bold" Foreground="#718078" />
                                <TextBlock Grid.Column="2" Text="SALARY" FontSize="10" FontWeight="Bold" Foreground="#718078" />
                                <TextBlock Grid.Column="3" Text="STATUS" FontSize="10" FontWeight="Bold"
                                           Foreground="#718078" HorizontalAlignment="Left" />
                            </Grid>
                        </Border>
                        <ListBox Grid.Row="1" ItemsSource="{Binding FilteredJobs}" SelectedItem="{Binding SelectedJob}"
                                 Background="Transparent" BorderThickness="0" Padding="0">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="BorderThickness" Value="0" />
                                </Style>
                                <Style Selector="ListBoxItem:pointerover">
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                                <Style Selector="ListBoxItem:selected">
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                                <Style Selector="ListBoxItem Border">
                                    <Setter Property="Background" Value="White" />
                                    <Setter Property="BorderBrush" Value="#E5EAE6" />
                                </Style>
                                <Style Selector="ListBoxItem:pointerover Border">
                                    <Setter Property="Background" Value="#F5F8F5" />
                                </Style>
                                <Style Selector="ListBoxItem:selected Border">
                                    <Setter Property="Background" Value="#EAF3EC" />
                                    <Setter Property="BorderBrush" Value="#B8D2BF" />
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:JobOpportunityViewModel">
                                    <Border BorderThickness="0,0,0,1" Padding="8,5" CornerRadius="3">
                                        <Grid ColumnSpacing="8" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="84" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="#20382E" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Company}" FontSize="11" Foreground="#52615A"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding SalaryLabel}" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="#16775C" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <ComboBox Grid.Column="3" Width="84" HorizontalAlignment="Right"
                                                      ItemsSource="{Binding AvailableStatuses}"
                                                      SelectedItem="{Binding SelectedStatus}" MinHeight="0"
                                                      Padding="0" BorderThickness="0" Background="Transparent"
                                                      FontSize="10" Foreground="#52615A"
                                                      HorizontalContentAlignment="Right"
                                                      ToolTip.Tip="Set opportunity status" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Grid.Row="1" Text="No opportunities in this scan" IsVisible="{Binding HasNoJobs}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="#718078" />
                        <TextBlock Grid.Row="1" Text="No roles match these filters" IsVisible="{Binding HasNoFilteredJobs}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="#718078" />
                    </Grid>
                </Border>

                <Border Grid.Column="1" Background="White" BorderBrush="#DEE5DF" BorderThickness="1" Padding="16">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="7">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Spacing="3">
                                <TextBlock Text="{Binding SelectedJobTitle}" FontSize="17" FontWeight="SemiBold"
                                           Foreground="#20382E" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding SelectedJobCompany}" FontSize="13" Foreground="#52615A" />
                            </StackPanel>
                                <Button Grid.Column="1" Content="Open posting" Classes="open-posting-button"
                                    Command="{Binding OpenSelectedJobCommand}"
                                    Padding="12,7" VerticalAlignment="Top" />
                        </Grid>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="{Binding SelectedJobSalaryLabel}" FontSize="13" FontWeight="SemiBold" Foreground="#16775C" />
                            <TextBlock Text="{Binding SelectedJobLocation}" FontSize="12" Foreground="#52615A" />
                            <TextBlock Text="{Binding SelectedJobSiteLabel}" FontSize="11" Foreground="#718078" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="14">
                            <TextBlock Text="{Binding SelectedJobDatePostedLabel}" FontSize="11" Foreground="#52615A" />
                            <TextBlock Text="{Binding SelectedJobTrackedSinceLabel}" FontSize="11" Foreground="#52615A" />
                            <TextBlock Text="{Binding SelectedJobLastSeenLabel}" FontSize="11" Foreground="#52615A" />
                        </StackPanel>
                        <Border Grid.Row="3" Background="#F4F7F4" Padding="8,5" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding SelectedJobAvailabilityLabel}" FontSize="11" FontWeight="SemiBold" Foreground="#27634B" />
                        </Border>
                        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" Margin="0,3,0,0">
                            <controls:MarkdownDescription Markdown="{Binding SelectedJobDescription}" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.RowSpan="3" Background="#B51B2D26"
                IsVisible="{Binding IsScanProgressOpen}">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                <Border Width="960" MaxHeight="700" Background="#FFFFFF"
                        BorderBrush="#D5DED8" BorderThickness="1" CornerRadius="6">
                    <Grid RowDefinitions="Auto,Auto,*">
                        <Border Background="#174B3D" Padding="20,15" CornerRadius="6,6,0,0">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="PROFILE SCAN" FontSize="10" FontWeight="Bold"
                                               Foreground="#A7D8BD" />
                                    <TextBlock Text="Parallel job-board searches" FontSize="20"
                                               FontWeight="SemiBold" Foreground="White" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ScanProgressSummary}" FontSize="13"
                                               FontWeight="SemiBold" Foreground="White"
                                               HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding ResponseCountLabel}" FontSize="11"
                                               FontWeight="SemiBold" Foreground="#F1B45A"
                                               HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding ScanElapsedLabel}" FontSize="10"
                                               Foreground="#C8DDD1" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding SearchConfigurationLabel}" FontSize="10"
                                               Foreground="#C8DDD1" HorizontalAlignment="Right" />
                                        <Button Content="Close" Command="{Binding CloseScanProgressCommand}"
                                            IsVisible="{Binding CanCloseScanProgress}"
                                            HorizontalAlignment="Right" Padding="12,5"
                                            Background="#F1B45A" Foreground="#25352C" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1" Margin="18,12,18,6"
                              ColumnDefinitions="2.5*,0.8*,1.1*,1.5*,150" ColumnSpacing="10">
                            <TextBlock Text="SEARCH PROFILE" FontSize="9" FontWeight="Bold" Foreground="#718078" />
                            <TextBlock Grid.Column="1" Text="BOARD" FontSize="9" FontWeight="Bold" Foreground="#718078" />
                            <TextBlock Grid.Column="2" Text="STATE" FontSize="9" FontWeight="Bold" Foreground="#718078" />
                            <TextBlock Grid.Column="3" Text="RESULTS" FontSize="9" FontWeight="Bold" Foreground="#718078" />
                            <TextBlock Grid.Column="4" Text="PROGRESS" FontSize="9" FontWeight="Bold" Foreground="#718078" />
                        </Grid>

                        <ScrollViewer Grid.Row="2" Margin="18,0,18,16" MaxHeight="570"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ScanProgressRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ScanProgressRow">
                                        <Border BorderBrush="#E5EAE6" BorderThickness="0,1,0,0"
                                                Padding="0,8">
                                            <Grid ColumnDefinitions="2.5*,0.8*,1.1*,1.5*,150"
                                                  ColumnSpacing="10" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SearchTerm}" FontSize="10"
                                                           FontWeight="SemiBold" Foreground="#263B31"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding SiteLabel}" FontSize="10"
                                                           Foreground="#52615A" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding State}" FontSize="10"
                                                           Foreground="#52615A" TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding State}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="{Binding Results}" FontSize="10"
                                                           Foreground="#52615A" TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding Results}" VerticalAlignment="Center" />
                                                <ProgressBar Grid.Column="4" Height="7" Minimum="0" Maximum="100"
                                                             Value="{Binding ProgressValue}"
                                                             IsIndeterminate="{Binding IsIndeterminate}"
                                                             VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
